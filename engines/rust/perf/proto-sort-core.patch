 /// Sorts `items` in place, keeping equal elements in input order. `less` must be a strict weak ordering.
+/// (prototype: one non-generic sort of an index permutation, then the permutation is applied by swaps)
 pub fn stable<T>(items: &mut [T], mut less: impl FnMut(&T, &T) -> bool) {
+    if items.len() < 2 {
+        return;
+    }
+    let mut idx: alloc::vec::Vec<u32> = (0..items.len() as u32).collect();
+    stable_core(&mut idx, &mut |a: &u32, b: &u32| less(&items[*a as usize], &items[*b as usize]));
+    // apply: position i receives items[idx[i]]
+    for i in 0..idx.len() {
+        let mut j = idx[i] as usize;
+        while j < i {
+            j = idx[j] as usize;
+        }
+        items.swap(i, j);
+    }
+}
