+/// `row_score` of `filter_row(kind, ..)` without materialising the row: one specialised pass per filter type.
+fn filter_score(kind: u8, row: &[u8], prev: &[u8], bpp: usize) -> u64 {
+    let abs = |v: u8| u64::from((v as i8).unsigned_abs());
+    let (head, tail) = row.split_at(bpp.min(row.len()));
+    let (phead, ptail) = prev.split_at(bpp.min(prev.len()));
+    match kind {
+        0 => row.iter().map(|&x| abs(x)).sum(),
+        1 => head.iter().map(|&x| abs(x)).sum::<u64>() + tail.iter().zip(row).map(|(&x, &a)| abs(x.wrapping_sub(a))).sum::<u64>(),
+        2 => row.iter().zip(prev).map(|(&x, &b)| abs(x.wrapping_sub(b))).sum(),
+        3 => {
+            head.iter().zip(phead).map(|(&x, &b)| abs(x.wrapping_sub(b / 2))).sum::<u64>()
+                + tail
+                    .iter()
+                    .zip(row)
+                    .zip(ptail)
+                    .map(|((&x, &a), &b)| abs(x.wrapping_sub(((u16::from(a) + u16::from(b)) / 2) as u8)))
+                    .sum::<u64>()
+        }
+        _ => {
+            head.iter().zip(phead).map(|(&x, &b)| abs(x.wrapping_sub(paeth(0, b, 0)))).sum::<u64>()
+                + tail
+                    .iter()
+                    .zip(row)
+                    .zip(ptail.iter().zip(prev))
+                    .map(|((&x, &a), (&b, &c))| abs(x.wrapping_sub(paeth(a, b, c))))
+                    .sum::<u64>()
+        }
+    }
+}
