{
  "name": "kerf-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kerf web workstation (TypeScript + DOM + three.js). Loads either engine's kerf.wasm.",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "node scripts/run.mjs dev rust",
    "dev:rust": "node scripts/run.mjs dev rust",
    "dev:zig": "node scripts/run.mjs dev zig",
    "dev:fixture": "node scripts/run.mjs dev fixture",
    "build:rust": "node scripts/run.mjs build rust",
    "build:zig": "node scripts/run.mjs build zig",
    "build": "npm run build:rust && npm run build:zig",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types test/unit.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "*",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
