{
  "name": "kerf-web",
  "private": true,
  "type": "module",
  "description": "Kerf web workstation (TypeScript + DOM + three.js). Loads the engine's kerf.wasm.",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "node scripts/run.mjs dev engine",
    "dev:fixture": "node scripts/run.mjs dev fixture",
    "build": "node scripts/run.mjs build engine",
    "build:serve": "node scripts/run.mjs build serve",
    "build:fixture": "node scripts/run.mjs build fixture",
    "typecheck": "tsc --noEmit",
    "test:unit": "node test/unit.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:serve": "node test/e2e-serve.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "puppeteer-core": "*",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  }
}
